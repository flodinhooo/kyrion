KYRION_POSTGRES_DB=kyrion
# Fresh installations only: protected local file containing a 32-byte CSPRNG
# base64url secret, valid for 30 minutes from its modification time. Never paste
# the secret value here. Existing installations do not need this file.
KYRION_BOOTSTRAP_SECRET_FILE=
KYRION_POSTGRES_USER=kyrion
KYRION_POSTGRES_PASSWORD=replace-with-a-local-password
KYRION_POSTGRES_DATA_PATH=E:/Kyrion/Data/postgres

# Core defaults to loopback. LAN access requires explicit operator approval and
# the existing Private/TCP 8080 firewall rule scoped to enrolled Pi addresses.
# Preview the intended change with infrastructure/dev/Set-CoreLan.ps1 first.
# KYRION_CORE_ADDRESS=0.0.0.0

# Core defaults to loopback. LAN access requires explicit operator approval and
# the existing Private/TCP 8080 firewall rule scoped to enrolled Pi addresses.
# Preview the intended change with infrastructure/dev/Set-CoreLan.ps1 first.
# KYRION_CORE_ADDRESS=0.0.0.0

# Optional read-only Home Assistant device import. Core only; never NEXT_PUBLIC_.
# Use the HA installation's literal private IPv4 address. Leave empty to disable.
KYRION_HA_URL=
KYRION_HA_TOKEN=
KYRION_HA_OWNER_ID=

# Spotify OAuth (optional; Core only). Register this exact HTTPS callback in the Spotify dashboard.
KYRION_SPOTIFY_CLIENT_ID=
KYRION_SPOTIFY_CLIENT_SECRET=
KYRION_SPOTIFY_REDIRECT_URI=https://kyrion-node.local/api/integrations/spotify/callback
KYRION_GOOGLE_CLIENT_ID=
KYRION_GOOGLE_CLIENT_SECRET=
KYRION_GOOGLE_REDIRECT_URI=https://kyrion-node.local/api/integrations/google/callback

# Optional cloud-conversation spike. Disabled means no cloud sessions or background work.
KYRION_CLOUD_CONVERSATION_ENABLED=false
OPENROUTER_API_KEY=
KYRION_OPENROUTER_MODEL=openrouter/free
KYRION_OPENROUTER_EXPLICIT_FREE_MODEL=openai/gpt-oss-120b:free
GEMINI_API_KEY=
KYRION_GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
KYRION_CLOUD_SESSION_TIMEOUT_SECONDS=300
KYRION_CLOUD_HISTORY_MAX_MESSAGES=12

# Optional Windows recovery-helper process environment (not loaded from this
# Spring file). Set in the launching shell or use ignored local settings.json;
# see docs/development-startup.md. Never set these through Web input.
# KYRION_RECOVERY_PI_HOST=your-trusted-node.local
# KYRION_RECOVERY_CORE_JAR=C:/path/to/matching/kyrion-core.jar
# Optional K-AI external context authorization. Keep false for local-only use.
KYRION_AI_CLOUD_ENABLED=false
