# Non-secret installer inputs. Do not put passwords, keys or tokens here.
KYRION_RELEASE=1.0.0
KYRION_HOSTNAME=kyrion.local
KYRION_INSTALL_DIR=/etc/kyrion/installer-v1
KYRION_DATA_DIR=/var/lib/kyrion
KYRION_SECRETS_DIR=/var/lib/kyrion/secrets
# Set these to the independently delivered release verification material.
KYRION_RELEASE_SIGNATURE=/opt/kyrion/release/manifest.sig
KYRION_RELEASE_PUBLIC_KEY=/opt/kyrion/release/release-public.pem

# Optional local embedding runtime; installer does not install a model.
KYRION_KNOWLEDGE_EMBEDDING_URL=http://127.0.0.1:11434
KYRION_KNOWLEDGE_EMBEDDING_MODEL=
KYRION_KNOWLEDGE_EMBEDDING_DIMENSION=768
