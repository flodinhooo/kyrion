# Optional local Core identity connection. Default remains disabled/offline-capable.
KYRION_CENTRAL_ENABLED=false
KYRION_CENTRAL_ISSUER=https://auth.example.invalid/realms/kyrion
KYRION_CENTRAL_CLIENT_ID=kyrion-local
KYRION_CENTRAL_ALLOW_LOOPBACK_HTTP=false
# For isolated loopback development ONLY, opt in and use:
# KYRION_CENTRAL_ISSUER=http://localhost:8089/realms/kyrion
# KYRION_CENTRAL_ALLOW_LOOPBACK_HTTP=true
# No client secret belongs on a local installation.
