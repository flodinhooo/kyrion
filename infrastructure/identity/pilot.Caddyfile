{
	admin off
	auto_https off
	log {
		output discard
	}
}

:8080 {
	@authentication path /realms/kyrion /realms/kyrion/* /resources/* /robots.txt
	handle @authentication {
		reverse_proxy keycloak:8080 {
			header_up Host auth.kyrion.ch
			header_up X-Forwarded-Host auth.kyrion.ch
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Port 443
		}
	}
	handle {
		respond 404
	}
}
