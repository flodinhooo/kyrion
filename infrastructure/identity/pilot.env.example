# Copy to private .env outside Git; replace all placeholders.
# Resolve current ARM64 registry digests and review security releases first.
IDENTITY_KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.8.2@sha256:replace-with-reviewed-digest
IDENTITY_POSTGRES_IMAGE=postgres:17@sha256:replace-with-reviewed-digest
IDENTITY_PROXY_IMAGE=caddy:2.10.2@sha256:replace-with-reviewed-digest
IDENTITY_DB_PASSWORD=replace-with-independent-random-value
IDENTITY_ADMIN_USERNAME=replace-with-private-admin-name
IDENTITY_ADMIN_PASSWORD=replace-with-independent-random-value
WEBSITE_CLIENT_SECRET=replace-with-independent-random-value
