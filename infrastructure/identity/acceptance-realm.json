{
  "realm": "kyrion",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": true,
  "verifyEmail": true,
  "resetPasswordAllowed": true,
  "defaultSignatureAlgorithm": "RS256",
  "accessTokenLifespan": 60,
  "oauth2DeviceCodeLifespan": 300,
  "oauth2DevicePollingInterval": 5,
  "clients": [
    {
      "clientId": "kyrion-website",
      "name": "Kyrion website development",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "secret": "${WEBSITE_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:3119/api/account/callback"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "id.token.signed.response.alg": "RS256"
      }
    },
    {
      "clientId": "kyrion-local",
      "protocolMappers": [
        {
          "name": "website-directory-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "kyrion-website",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ],
      "name": "Kyrion local installations",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [],
      "webOrigins": [],
      "attributes": {
        "oauth2.device.authorization.grant.enabled": "true",
        "id.token.signed.response.alg": "RS256"
      }
    }
  ],
  "smtpServer": {
    "port": "1025",
    "host": "mailpit",
    "starttls": "false",
    "from": "kyrion@acceptance.invalid",
    "ssl": "false",
    "auth": "false"
  },
  "requiredCredentials": ["password"]
}
