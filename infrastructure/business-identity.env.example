# Optional, instance-controlled SMTP. Leave HOST empty for local-only operation.
# STARTTLS and certificate identity checks are mandatory; no plaintext fallback.
KYRION_IDENTITY_SMTP_HOST=
KYRION_IDENTITY_SMTP_PORT=587
KYRION_IDENTITY_SMTP_USERNAME=
KYRION_IDENTITY_SMTP_PASSWORD=replace-with-private-smtp-credential
KYRION_IDENTITY_SMTP_FROM=verification@example.invalid
# Optional explicitly trusted resolver; empty uses host DNS. Not a browser setting.
KYRION_IDENTITY_DNS_SERVER=

# Local security CLI only. Keep secrets outside the repository and use private files.
KYRION_DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/kyrion
KYRION_DATABASE_USER=kyrion
KYRION_DATABASE_PASSWORD_FILE=/etc/kyrion/secrets/postgres-password
KYRION_AUDIT_INTEGRITY_KEY_FILE=/etc/kyrion/secrets/audit-integrity.key
