KYRION_WEBSITE_ACCOUNT_ENABLED=false
KYRION_WEBSITE_ORIGIN=http://localhost:3001
KYRION_WEBSITE_OIDC_ISSUER=http://localhost:8089/realms/kyrion
KYRION_WEBSITE_OIDC_CLIENT_ID=kyrion-website
KYRION_WEBSITE_OIDC_CLIENT_SECRET=replace-with-the-private-development-client-secret
KYRION_WEBSITE_ACCOUNT_DATABASE_URL=postgresql://kyrion_website:replace-with-private-password@localhost:5549/kyrion_website
# Only accepted outside production and only for loopback URLs.
KYRION_WEBSITE_ACCOUNT_DEV_HTTP=true
