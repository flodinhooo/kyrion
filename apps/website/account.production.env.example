# Prepared configuration only: retain disabled until operational acceptance.
# Server-only Vercel variables; never distribute to local installations.
KYRION_WEBSITE_ACCOUNT_ENABLED=false
KYRION_WEBSITE_ORIGIN=https://kyrion.ch
KYRION_WEBSITE_OIDC_ISSUER=https://auth.kyrion.ch/realms/kyrion
KYRION_WEBSITE_OIDC_CLIENT_ID=kyrion-website
KYRION_WEBSITE_OIDC_CLIENT_SECRET=replace-with-independent-central-client-secret
# A NEW separate website database, verified TLS and restricted credentials.
KYRION_WEBSITE_ACCOUNT_DATABASE_URL=postgresql://website_app:replace-with-private-password@replace-with-approved-database-host/website_sessions?sslmode=verify-full
KYRION_WEBSITE_ACCOUNT_DEV_HTTP=false
