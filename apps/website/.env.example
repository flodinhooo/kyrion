# Server-only. Configure in Vercel's project environment settings, then redeploy.
# Never prefix these variables with NEXT_PUBLIC_.
# Exact public origin, without a path. For local development use http://localhost:3001.
CONTACT_FORM_ORIGIN=https://kyrion.ch
SMTP_HOST=mail.infomaniak.com
# 465 = implicit TLS; 587 = mandatory STARTTLS. No insecure ports are supported.
SMTP_PORT=465
# Full mailbox login address; not the Infomaniak Manager login.
SMTP_USER=hello@kyrion.ch
# Use the mailbox's SMTP password. Do not commit a real value.
SMTP_PASSWORD=replace-with-mailbox-smtp-password
# Single authorized sender address, without a display name or address list.
SMTP_FROM=hello@kyrion.ch
# Single receiving mailbox, without a display name or address list.
CONTACT_EMAIL_TO=hello@kyrion.ch

