AI_SERVICE_URL=http://127.0.0.1:8000
CORE_SERVICE_URL=http://127.0.0.1:8080
KYRION_PUBLIC_URL=http://localhost:3000
# Local Spotify callbacks on 127.0.0.1 return to this localhost origin (same port).
KYRION_INSECURE_LAN_HTTP=false
# Spotify OAuth is configured on Kyrion Core, never in the browser-facing Web container.
