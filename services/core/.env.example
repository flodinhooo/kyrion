# Local Kyrion Core configuration.
# Copy this file to .env. The real .env is ignored by Git.

# PostgreSQL (use the same password configured in infrastructure/.env)
KYRION_DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/kyrion
KYRION_DATABASE_USER=kyrion
KYRION_DATABASE_PASSWORD=

# Core listener
KYRION_CORE_ADDRESS=127.0.0.1

# Read-only Home Assistant import
KYRION_HA_URL=http://192.168.1.116:8123
KYRION_HA_TOKEN=
KYRION_HA_OWNER_ID=

# Optional service endpoints
KYRION_AI_BASE_URL=http://127.0.0.1:8000
KYRION_CREDENTIAL_KEY_FILE=E:/Kyrion/Data/secrets/credential.key
KYRION_AUDIT_INTEGRITY_KEY_FILE=E:/Kyrion/Data/secrets/audit-integrity.key
