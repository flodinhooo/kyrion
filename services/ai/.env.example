OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
KYRION_ALLOWED_MODELS=gemma3:1b,gemma3:4b,qwen3:8b
OLLAMA_CONNECT_TIMEOUT_SECONDS=5
KYRION_STT_MODEL=E:/Kyrion/Data/models/faster-whisper-small/models--Systran--faster-whisper-small/snapshots/REPLACE_WITH_SNAPSHOT_ID
KYRION_STT_DEVICE=cpu
KYRION_STT_COMPUTE_TYPE=int8
KYRION_TTS_PROVIDER=http_batch
KYRION_HTTP_TTS_URL=http://127.0.0.1:8020
# Experimental opt-in only. Chatterbox above remains the stable batch fallback.
# Select with KYRION_TTS_PROVIDER=xtts only while this flag is explicitly true.
KYRION_XTTS_EXPERIMENTAL_ENABLED=false
KYRION_XTTS_TTS_URL=http://127.0.0.1:8031
KYRION_XTTS_TIMEOUT_SECONDS=120
# Compatibility only for an explicitly selected legacy Qwen batch runtime.
KYRION_QWEN_TTS_URL=http://127.0.0.1:8010
KYRION_DEFAULT_VOICE_ID=velora
# Optional overrides for the reviewed fixed-response manifest and the generated
# complete-utterance template cache. Cache entries contain synthesized speech
# and must remain outside Git.
KYRION_VOICE_RESPONSE_MANIFEST=E:/dev/Kyrion/kyrion/services/ai/voice-responses/manifest.json
KYRION_VOICE_RESPONSE_CACHE_DIR=E:/Kyrion/Data/voice-response-cache
KYRION_VOICE_RESPONSE_SYNTHESIS_REVISION=configured-normal-tts-v1
# Optional explicit local development provider; never selected as a silent fallback.
KYRION_PIPER_EXECUTABLE=E:/dev/Kyrion/kyrion/services/ai/.venv/Scripts/piper.exe
KYRION_PIPER_MODEL=E:/Kyrion/Data/models/piper/de_DE-kerstin-low/de/de_DE/kerstin/low/de_DE-kerstin-low.onnx
